<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_intake_evaluation_form_view" model="ir.ui.view">
        <field name="name">product.template.intake_evaluation.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Products">
                <sheet>
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'preview_image': 'image_128'}"
                    />
                    <div class="oe_title">
                        <label for="name" string="Product Name" />
                        <h1>
                            <div class="d-flex">
                                <field name="priority" widget="priority" class="mr-3" />
                                <field
                                    class="o_text_overflow"
                                    name="name"
                                    placeholder="e.g. Cheese Burger"
                                />
                            </div>
                        </h1>
                    </div>
                    <notebook>
                        <page
                            string="Appraisal Information"
                            name="appraisal_information"
                        >
                            <group>
                                <group>
                                    <field name="valuation_status" readonly="1" />
                                    <field
                                        name="product_state_id"
                                        options="{'no_open': True}"
                                    />
                                    <field name="create_date" readonly="1" />
                                    <field name="create_uid" readonly="1" />
                                    <field name="write_date" readonly="1" />
                                    <field name="write_uid" readonly="1" />
                                    <field name="barcode" readonly="1" />
                                    <field name="qty_available" readonly="1" />
                                </group>
                                <group>
                                    <field
                                        name="branch_id"
                                        readonly="1"
                                        options="{'no_open': True}"
                                    />
                                    <field
                                        name="sales_office_id"
                                        readonly="1"
                                        options="{'no_open': True}"
                                    />
                                    <field name="carrier_contact_person" />
                                    <field name="tracking_no_1" />
                                    <field name="tracking_no_2" />
                                    <field name="carrier_note" />
                                    <field name="valuation_comment" readonly="1" />
                                </group>
                            </group>
                        </page>
                        <page string="Product Image" name="product_image">
                            <group
                                name="product_template_images"
                                string="Extra Product Media"
                            >
                                <field
                                    name="product_template_image_ids"
                                    class="o_website_sale_image_list"
                                    context="{'default_name': name}"
                                    mode="kanban"
                                    add-label="Add a Media"
                                    nolabel="1"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_template_intake_evaluation_tree_view" model="ir.ui.view">
        <field name="name">product.template.intake_evaluation.tree</field>
        <field name="model">product.template</field>
        <field name="type">tree</field>
        <field name="priority" eval="26" />
        <field name="arch" type="xml">
            <tree
                decoration-success="valuation_status == 'acceptable'"
                decoration-danger="valuation_status == 'need_info'"
                decoration-info="valuation_status == 'received'"
            >
                <field name="name" string="Product Name" options="{}" />
                <field
                    name="image_1920"
                    widget="image"
                    options="{'preview_image': 'image_128'}"
                    optional="show"
                />
                <field name="barcode" optional="show" />
                <field name="product_state_id" optional="show" />
                <field name="create_uid" optional="show" />
                <field name="create_date" widget="date" optional="show" />
                <field name="write_uid" optional="show" />
                <field name="write_date" widget="date" optional="show" />
                <field
                    name="valuation_status"
                    optional="show"
                    widget="badge"
                    decoration-success="valuation_status == 'acceptable'"
                    decoration-danger="valuation_status == 'need_info'"
                    decoration-info="valuation_status == 'received'"
                />
                <field name="branch_id" optional="show" />
                <field name="sales_office_id" optional="show" />
                <field name="carrier_contact_person" optional="show" />
                <field name="tracking_no_1" optional="show" />
                <field name="tracking_no_2" optional="show" />
                <field name="carrier_note" optional="show" />
                <field name="valuation_comment" optional="show" />
            </tree>
        </field>
    </record>

    <record id="product_template_intake_evaluation_search_view" model="ir.ui.view">
        <field name="name">product.template.intake_evaluation.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Search Intake Evaluation Products">
                <field name="name" />
                <field name="barcode" />
                <field name="product_state_id" />
                <field name="valuation_status" />
                <field name="branch_id" />
                <field name="sales_office_id" />
                <field name="carrier_contact_person" />
                <field name="tracking_no_1" />
                <field name="tracking_no_2" />
                <field name="valuation_comment" />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        string="Branch"
                        name="branch_id"
                        domain="[]"
                        context="{'group_by': 'branch_id'}"
                    />
                    <filter
                        string="Sales Office"
                        name="sales_office_id"
                        domain="[]"
                        context="{'group_by': 'sales_office_id'}"
                    />
                    <filter
                        string="Valuation Status"
                        name="valuation_status"
                        domain="[]"
                        context="{'group_by': 'valuation_status'}"
                    />
                    <filter
                        string="Non-displayed Products"
                        name="inactive"
                        domain="[('active','=',False)]"
                    />
                </group>
            </search>
        </field>
    </record>

    <record
        id="action_product_template_intake_evaluation_view"
        model="ir.actions.act_window"
    >
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field
            name="context"
        >{'update_branch': 1,'form_view_ref':'product_intake_evaluation.product_template_intake_evaluation_form_view'}</field>
        <field name="view_id" ref="product_template_intake_evaluation_tree_view" />
        <field
            name="search_view_id"
            ref="product_template_intake_evaluation_search_view"
        />
    </record>
</odoo>
