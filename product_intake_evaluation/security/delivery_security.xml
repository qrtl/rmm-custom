<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_intake_evaluation" model="ir.module.category">
        <field name="name">Intake Evaluation</field>
        <field name="sequence">13</field>
    </record>
    <record id="group_intake_evaluation_user" model="res.groups">
        <field name="name">Intake Evaluation User</field>
        <field
            name="category_id"
            ref="product_intake_evaluation.module_category_intake_evaluation"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('base_group_backend.group_backend_ui_users'))]"
        />
    </record>
    <record id="group_intake_evaluation_manager" model="res.groups">
        <field name="name">Intake Evaluation Manager</field>
        <field
            name="category_id"
            ref="product_intake_evaluation.module_category_intake_evaluation"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('product_intake_evaluation.group_intake_evaluation_user'))]"
        />
    </record>
    <record id="group_intake_evaluation_admin" model="res.groups">
        <field name="name">Intake Evaluation Admin</field>
        <field
            name="category_id"
            ref="product_intake_evaluation.module_category_intake_evaluation"
        />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="intake_evaluation_user_rule" model="ir.rule">
        <field name="name">product.template Intake Evaluation User</field>
        <field name="model_id" ref="product.model_product_template" />
        <field
            name="domain_force"
        >[('assigned_branch_id','=',user.commercial_partner_id.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('product_intake_evaluation.group_intake_evaluation_user'))]"
        />
    </record>
    <record id="intake_evaluation_manager_rule" model="ir.rule">
        <field name="name">product.template Intake Evaluation Manager</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="domain_force">[('assigned_branch_id','!=',False)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('product_intake_evaluation.group_intake_evaluation_manager'))]"
        />
    </record>
    <record id="intake_evaluation_user_partner_rule" model="ir.rule">
        <field name="name">res.parnter Intake Evaluation User</field>
        <field name="model_id" ref="product.model_res_partner" />
        <field
            name="domain_force"
        >['|',('id','=',2),('commercial_partner_id','=',user.commercial_partner_id.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('product_intake_evaluation.group_intake_evaluation_user'))]"
        />
    </record>
    <record id="intake_evaluation_manager_partner_rule" model="ir.rule">
        <field name="name">res.partner Intake Evaluation Manager</field>
        <field name="model_id" ref="product.model_res_partner" />
        <field name="domain_force">[('is_intake_evaluation_branch','!=',False)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('product_intake_evaluation.group_intake_evaluation_manager'))]"
        />
    </record>
    <!-- <record id="intake_evaluation_user_message_rule" model="ir.rule">
        <field name="name">mail.message Intake Evaluation User</field>
        <field name="model_id" ref="mail.model_mail_message" />
        <field
            name="domain_force"
        >[('message_type','=','comment'),('subtype_id.internal','=', False)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('product_intake_evaluation.group_intake_evaluation_user'))]"
        />
    </record> -->
</odoo>
