<odoo>
    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.product.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="openai_generated_name" />
            </field>
        </field>
    </record>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_title')]" position="after">
                <div
                    class="col-4"
                    attrs="{'invisible': [('openai_generated_name', '=', False)]}"
                >
                    <label for="openai_generated_name" string="OpenAI Generated Name" />
                    <field name="openai_generated_name" readonly="1" />
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_product_template_name_generator" model="ir.actions.server">
        <field name="name">Generate Product Name Using OpenAI</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="state">code</field>
        <field name="code">action = records.action_generate_product_name()</field>
    </record>
</odoo>
