<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="group_weighing_integration" model="res.groups">
        <field name="name">Weighing Integration</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="comment">Users allowed to create weighing lines via the
            external integration.</field>
    </record>
    <record id="product_weighing_line_comp_rule" model="ir.rule">
        <field name="name">product.weighing.line multi-company</field>
        <field name="model_id" ref="model_product_weighing_line" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
