<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.weighing.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Weighing" name="weighing">
                    <group>
                        <group>
                            <field name="total_net_weight" readonly="1" />
                            <field name="weighing_count" readonly="1" />
                            <field name="weighing_confirmed_at" readonly="1" />
                        </group>
                    </group>
                    <field name="weighing_line_ids" readonly="1">
                        <tree create="false" edit="false" delete="false">
                            <field name="measured_at" />
                            <field name="weighing_id" />
                            <field name="receipt_no" />
                            <field name="gross_weight" />
                            <field name="dust_detail" />
                            <field name="dust_weight" />
                            <field name="net_weight" />
                            <field name="measurer_name" />
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="weighing_id" />
                                    <field name="measured_at" />
                                    <field name="measurer_name" />
                                    <field name="receipt_no" />
                                </group>
                                <group>
                                    <field name="gross_weight" />
                                    <field name="dust_detail" />
                                    <field name="dust_weight" />
                                    <field name="net_weight" />
                                </group>
                                <group>
                                    <field name="image_hash" />
                                </group>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
