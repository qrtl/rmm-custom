<odoo>
    <record id="action_download_product_template_extra_image" model="ir.actions.server">
        <field name="name">Download Product Extra Images</field>
        <field name="model_id" ref="model_product_template" />
        <field name="binding_model_id" ref="model_product_template" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records._download_product_images_zip()
        </field>
    </record>
    <record id="action_download_product_product_extra_image" model="ir.actions.server">
        <field name="name">Download Product Extra Images</field>
        <field name="model_id" ref="model_product_product" />
        <field name="binding_model_id" ref="model_product_product" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records._download_product_images_zip()
        </field>
    </record>
</odoo>
