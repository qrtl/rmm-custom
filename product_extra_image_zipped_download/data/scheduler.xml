<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- This cron is intended for the initial update of existing product images, therefore is expected to
    be disabled in normal circumstances. -->
    <record model="ir.cron" id="update_product_image_name">
        <field name="name">Update Product Image Name</field>
        <field name="model_id" ref="model_product_image" />
        <field name="state">code</field>
        <field name="code">model._cron_update_product_image(1000)</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="False" />
    </record>
    <record model="ir.cron" id="delete_product_image_zip">
        <field name="name">Delete Product Image Zip</field>
        <field name="model_id" ref="model_ir_attachment" />
        <field name="state">code</field>
        <field name="code">model._cron_delete_product_image_zip()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
