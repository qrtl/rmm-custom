<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_delivery_carrier_user" model="res.groups">
        <field name="name">Delivery Carrier User</field>
        <field name="implied_ids" eval="[(4, ref('base_group_backend.group_backend_ui_users'))]" />
    </record>
    <record id="group_delivery_carrier_manager" model="res.groups">
        <field name="name">Delivery Carrier Manager</field>
        <!-- Manager group might not inherit operator group to avoid conflicts -->
        <field name="implied_ids" eval="[(4, ref('delivery_carrier_product.group_delivery_carrier_user'))]" />
    </record>
    <record id="delivery_carrier_user_rule" model="ir.rule">
        <field name="name">product.template Delivery Carrier User</field>
        <field name="model_id" ref="product.model_product_template" />
        <field
            name="domain_force"
        >[('assigned_branch_id','=',user.commercial_partner_id.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('delivery_carrier_product.group_delivery_carrier_user'))]"
        />
    </record>
    <record id="delivery_carrier_manager_rule" model="ir.rule">
        <field name="name">product.template Delivery Carrier Manager</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="domain_force">[('assigned_branch_id','!=',False)]</field>
        <field name="groups" eval="[Command.link(ref('delivery_carrier_product.group_delivery_carrier_manager'))]" />
    </record>
</odoo>
