<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_delivery_carrier_form_view" model="ir.ui.view">
        <field name="name">product.template.delivery_carrier.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Products">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Product Name" />
                        <h1>
                            <div class="d-flex">
                                <field name="priority" widget="priority" class="mr-3" groups="base_group_backend.group_backend_ui_users"/>
                                <field
                                    class="o_text_overflow"
                                    name="name"
                                    groups="base_group_backend.group_backend_ui_users"
                                    placeholder="e.g. Cheese Burger"
                                />
                            </div>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Appraisal Information" name="appraisal_information">
                            <group>
                                <group>
                                    <field name="product_state_id" groups="base_group_backend.group_backend_ui_users"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                    <field name="barcode" readonly="1"/>
                                    <field name="qty_available" readonly="1"/>
                                </group>
                                <group>
                                    <field name="valuation_status_id" groups="base_group_backend.group_backend_ui_users"/>
                                    <field name="carrier_branch" groups="base_group_backend.group_backend_ui_users"/>
                                    <field name="carrier_contact_person" groups="base_group_backend.group_backend_ui_users"/>
                                    <field name="tracking_no_1" groups="base_group_backend.group_backend_ui_users"/>
                                    <field name="tracking_no_2" groups="base_group_backend.group_backend_ui_users"/>
                                    <field name="valuation_comment" groups="base_group_backend.group_backend_ui_users"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_template_delivery_carrier_tree_view" model="ir.ui.view">
        <field name="name">product.template.delivery_carrier.tree</field>
        <field name="model">product.template</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" widget="date" optional="show" />
                <field name="name" string="Product Name" />
                <field name="product_state_id" optional="show" />
                <field name="valuation_status_id" optional="show" />
                <field name="carrier_branch" optional="show"/>
                <field name="carrier_contact_person" optional="show" />
                <field name="tracking_no_1" optional="show" />
                <field name="tracking_no_2" optional="show" />
                <field name="valuation_comment" optional="show" />
            </tree>
        </field>
    </record>

    <record id="product_template_delivery_carrier_search_view" model="ir.ui.view">
        <field name="name">product.template.delivery_carrier.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Search Delivery Carrier Products">
                <field name="name" />
                <field name="product_state_id" />
                <field name="valuation_status_id" />
                <field name="carrier_branch" />
                <field name="carrier_contact_person" />
                <field name="tracking_no_1" />
                <field name="tracking_no_2" />
                <field name="valuation_comment" />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        string="State"
                        name="product_state"
                        domain="[]"
                        context="{'group_by': 'product_state_id'}"
                    />
                    <filter
                        string="Valuation Status"
                        name="valuation_status"
                        domain="[]"
                        context="{'group_by': 'valuation_status_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_template_delivery_carrier_view" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {
                'view_mode': 'tree',
                'view_id': ref('product_template_delivery_carrier_tree_view'),
                }),
            (0, 0, {
                'view_mode': 'form',
                'view_id': ref('product_template_delivery_carrier_form_view'),
                }),
            ]"
        />
        <field name="search_view_id" ref="product_template_delivery_carrier_search_view" />
    </record>
</odoo>
