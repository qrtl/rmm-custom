<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Appraisal Information">
                    <group>
                        <group>
                            <field name="product_state_id" />
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="write_date" readonly="1"/>
                            <field name="write_uid" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                            <field name="qty_available" readonly="1"/>
                        </group>
                        <group>
                            <field name="valuation_status_id" />
                            <field name="assigned_branch_id" />
                            <field name="carrier_contact_person" />
                            <field name="tracking_no_1" />
                            <field name="tracking_no_2" />
                            <field name="valuation_comment" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
